# Local Payload/Postgres defaults.
# Порт 5432 — локальный Postgres (pnpm db:up). Через Docker (pnpm db:up:docker) порт 5433.
DATABASE_URI=postgres://motophd:motophd@localhost:5432/motophd
PAYLOAD_SECRET=replace-with-a-long-random-secret

# --- consent-analytics ---
# Optional analytics identifiers. With both empty, the consent banner and trackers stay disabled.
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# --- feature/media-r2-stream ---
# Create a private R2 bucket and an Object Read & Write token in Cloudflare.
R2_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Create a Cloudflare Stream signing key and copy the customer code from Stream's embed snippet.
CF_STREAM_CUSTOMER_CODE=
CF_STREAM_KEY_ID=
CF_STREAM_KEY_PEM=

# --- emails-f9 ---
# Leave RESEND_API_KEY or EMAIL_FROM empty to log outgoing emails locally instead.
RESEND_API_KEY=
EMAIL_FROM=
# Public address used in links inside emails.
APP_URL=http://localhost:3000
# WhatsApp or Telegram link for feedback-tier students.
FEEDBACK_CONTACT_URL=
