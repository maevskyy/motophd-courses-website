{
	# Включает сбор Prometheus-метрик; отдаём их отдельным внутренним
	# слушателем :2020 (см. ниже). Admin API остаётся на localhost:2019
	# внутри контейнера и наружу/в сеть compose не публикуется.
	metrics
}

# Сервер принимает запросы только от Cloudflare. До 30.09 он отвечал любому,
# кто знает его IP: админка открывалась без Cloudflare Access, а страну
# посетителя (CF-IPCountry, региональные цены) можно было подделать.
# Диапазоны — https://www.cloudflare.com/ips-v4 и /ips-v6 (снимок 30.09.2026);
# Cloudflare меняет их редко, сверять раз в полгода.
# route, а не голые директивы: внутри route порядок как написан, иначе Caddy
# сортирует и respond шёл бы после handle — проверка не срабатывала бы.
(cloudflare_only) {
	@notCloudflare not remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	respond @notCloudflare "Forbidden" 403
}

# Публичный сайт. По ARCHITECTURE админка сюда не выходит: /admin* режем,
# полноценная админка живёт на admin.motophd.com за Cloudflare Access.
# /api НЕ режем — там платёжные вебхуки и выдача защищённых PDF.
motophd.com, www.motophd.com {
	tls /certs/origin.pem /certs/origin.key
	encode gzip

	route {
		import cloudflare_only

		handle /admin* {
			respond 404
		}

		handle {
			reverse_proxy app:3000
		}
	}
}

# Админка. Доступ ограничивается Cloudflare Access (см. monitoring/APPLY.md).
admin.motophd.com {
	tls /certs/origin.pem /certs/origin.key
	encode gzip

	route {
		import cloudflare_only
		# Корень поддомена ведёт в админку: без этого люди видят маркетинговый
		# сайт и думают, что админка не работает.
		redir / /admin 302
		reverse_proxy app:3000
	}
}

grafana.motophd.com {
	tls /certs/origin.pem /certs/origin.key
	encode gzip

	route {
		import cloudflare_only
		reverse_proxy grafana:3000
	}
}

# Только для Prometheus внутри сети compose: порт наружу не публикуется.
:2020 {
	metrics /metrics
}
