GHCR_IMAGE=ghcr.io/maevskyy/motophd
IMAGE_TAG=latest

POSTGRES_DB=motophd
POSTGRES_USER=motophd
POSTGRES_PASSWORD=replace-with-a-long-random-password

DATABASE_URI=postgres://motophd:replace-with-a-long-random-password@postgres:5432/motophd
PAYLOAD_SECRET=replace-with-a-long-random-secret

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-long-random-password

# --- app ---
# Публичный адрес сайта: ссылки в письмах и абсолютные URL.
APP_URL=https://motophd.com
# Resend: ключ API и адрес отправителя на верифицированном домене.
RESEND_API_KEY=replace-with-resend-api-key
EMAIL_FROM=MotoPhD <noreply@motophd.com>
# Куда ведёт кнопка обратной связи тарифа feedback (Telegram/форма).
FEEDBACK_CONTACT_URL=https://t.me/replace-with-contact

# Аналитика: подключается только после согласия пользователя (consent-gated).
# Пустое значение = счётчик не грузится вообще.
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# --- media (Cloudflare R2 + Stream) ---
# Те же значения, что в локальном .env (MOT-2): без них видео показывает
# заглушку, а PDF-роут отвечает 404 — «выключенный режим», сайт не падает.
R2_BUCKET=motophd-media
R2_ENDPOINT=https://replace-with-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
CF_STREAM_CUSTOMER_CODE=replace-with-customer-code
CF_STREAM_KEY_ID=replace-with-stream-signing-key-id
CF_STREAM_KEY_PEM=replace-with-stream-signing-key-pem-base64

# --- observability ---
# Telegram bot and chat receiving Grafana alerts.
TG_BOT_TOKEN=replace-with-telegram-bot-token
TG_CHAT_ID=replace-with-telegram-chat-id

# Cloudflare R2 S3 API for offsite PostgreSQL dumps (gzip, без шифрования —
# доступ ограничен токеном бакета).
BACKUP_R2_ENDPOINT=https://replace-with-account-id.r2.cloudflarestorage.com
BACKUP_R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
BACKUP_R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
BACKUP_R2_BUCKET=motophd-backups

# A Healthchecks.io ping URL dedicated to the nightly backup job.
HEALTHCHECKS_BACKUP_URL=https://hc-ping.com/replace-with-check-uuid
TZ=UTC
