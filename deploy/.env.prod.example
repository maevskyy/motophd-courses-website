GHCR_IMAGE=ghcr.io/maevskyy/motophd
IMAGE_TAG=latest

POSTGRES_DB=motophd
POSTGRES_USER=motophd
POSTGRES_PASSWORD=replace-with-a-long-random-password

DATABASE_URI=postgres://motophd:replace-with-a-long-random-password@postgres:5432/motophd
PAYLOAD_SECRET=replace-with-a-long-random-secret

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-long-random-password
