GHCR_IMAGE=ghcr.io/maevskyy/motophd
IMAGE_TAG=latest

POSTGRES_DB=motophd
POSTGRES_USER=motophd
POSTGRES_PASSWORD=replace-with-a-long-random-password

DATABASE_URI=postgres://motophd:replace-with-a-long-random-password@postgres:5432/motophd
PAYLOAD_SECRET=replace-with-a-long-random-secret

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-long-random-password

# --- observability ---
# Telegram bot and chat receiving Grafana alerts.
TG_BOT_TOKEN=replace-with-telegram-bot-token
TG_CHAT_ID=replace-with-telegram-chat-id

# Cloudflare R2 S3 API for encrypted offsite PostgreSQL dumps.
BACKUP_R2_ENDPOINT=https://replace-with-account-id.r2.cloudflarestorage.com
BACKUP_R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
BACKUP_R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
BACKUP_R2_BUCKET=motophd-backups

# A Healthchecks.io ping URL dedicated to the nightly backup job.
HEALTHCHECKS_BACKUP_URL=https://hc-ping.com/replace-with-check-uuid
TZ=UTC
