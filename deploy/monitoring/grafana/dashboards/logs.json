{
  "uid": "motophd-logs",
  "title": "MotoPhD / Логи",
  "tags": ["motophd", "loki", "logs"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "job",
        "label": "Источник",
        "type": "query",
        "datasource": { "type": "loki", "uid": "loki" },
        "query": "label_values(job)",
        "current": { "text": "docker", "value": "docker" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Логи Docker",
      "type": "logs",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 16, "w": 24, "x": 0, "y": 0 },
      "targets": [{ "refId": "A", "expr": "{job=~\"$job\"}" }],
      "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Descending" }
    }
  ]
}
