{
  "uid": "motophd-containers",
  "title": "MotoPhD / Контейнеры",
  "tags": ["motophd", "containers"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "CPU контейнеров",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [{ "refId": "A", "expr": "sum by(name) (rate(container_cpu_usage_seconds_total{image!=\"\",name!=\"\"}[5m]))", "legendFormat": "{{name}}" }]
    },
    {
      "id": 2,
      "title": "RSS контейнеров",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [{ "refId": "A", "expr": "container_memory_rss{image!=\"\",name!=\"\"}", "legendFormat": "{{name}}" }]
    },
    {
      "id": 3,
      "title": "Перезапуски за 24 часа",
      "type": "table",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "targets": [{ "refId": "A", "expr": "changes(container_start_time_seconds{name!=\"\"}[24h])", "instant": true, "format": "table" }]
    }
  ]
}
