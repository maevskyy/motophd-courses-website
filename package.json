{
  "name": "motophd-courses-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "payload": "payload",
    "generate:types": "payload generate:types",
    "seed": "payload run src/seed/seed.ts",
    "db:up": "brew services start postgresql@16",
    "db:down": "brew services stop postgresql@16",
    "db:setup": "./scripts/db-setup.sh",
    "db:reset": "./scripts/db-setup.sh --reset && pnpm payload migrate && pnpm seed",
    "db:psql": "psql postgres://motophd:motophd@localhost:5432/motophd",
    "db:up:docker": "docker compose -f docker-compose.dev.yml up -d",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "prettier --check .",
    "format:write": "prettier --write ."
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1113.0",
    "@payloadcms/db-postgres": "^3.86.0",
    "@payloadcms/next": "^3.86.0",
    "@payloadcms/richtext-lexical": "^3.86.0",
    "@payloadcms/storage-s3": "^3.86.0",
    "graphql": "^17.0.2",
    "next": "^15.5.6",
    "next-intl": "^4.3.4",
    "payload": "^3.86.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sass": "^1.93.2",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.62.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.8.1",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^9.37.0",
    "eslint-config-next": "^15.5.6",
    "jsdom": "^29.1.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.10.0"
}
